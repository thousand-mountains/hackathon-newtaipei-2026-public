# 複製成 .env 後填值。.env 不進 git（CONSTITUTION §7）。所有值都不得出現在程式碼或文件裡。
RUN_MODE=fixture            # fixture | bedrock
MODEL_PROVIDER=bedrock      # bedrock | openai（openai 僅開發期調 prompt）
AWS_PROFILE=                # 本機開發用 profile 名稱
AWS_REGION=                 # 賽制限定：us-east-1 或 us-west-2（本專案用 us-west-2）。不要填其他區
BEDROCK_MODEL_ID_EXTRACT=   # N1 抽取用 model id 或 inference profile id
BEDROCK_MODEL_ID_DRAFT=     # N5 主筆用
OPENAI_MODEL_ID=            # MODEL_PROVIDER=openai 時真正被呼叫的 model id（無預設，缺值即 LLMError）
OPENAI_API_KEY=             # 同上；僅開發期調 prompt，其輸出不得當驗收證據
RETRIEVER=lawtable_only     # lawtable_only | kb
BEDROCK_KB_ID=              # Managed Knowledge Base id
KB_MIN_SCORE=0.15            # **依 KB 而異**：MANAGED 用 0.15、S3 Vectors 用 0.76（見 settings.py DEFAULT_KB_MIN_SCORE 註解）
BEDROCK_RERANK_MODEL_ID=     # 重排模型 arn；**留空＝不重排**（行為與加這功能之前相同）
RERANK_MIN_SCORE=0.5         # 重排後的相關性門檻。實測真實案件 0.809–1.000、語意無關 0.000–0.057
SIMILAR_CASE_QUOTA=歷史訴願決定書/:2,新北訴願決定書_全量/:3    # 相似案通道的前綴與席次。**目錄名跟著 corpus 走**，換 KB 要一起換
REF_PREFIXES=行政函釋/,司法院釋字及行政判解/    # N5 可引用來源的白名單。**放寬等於放寬系統能引用什麼，要 qa-legal 同意**
S3_KB_BUCKET=               # ingest_kb.py 用
